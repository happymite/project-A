<% layout("/layouts/boilerplate.ejs") %>
   <style>

    .filters{
      display:flex;
      flex-wrap:wrap;
      align-items: center;
      margin:2rem 0 1rem 0;
    }

    .filter{
      text-align: center;
      margin-left: 1.5rem;
      opacity: 0.7;
    }

    .filter:hover{
      opacity: 1;
      cursor: pointer;
    }

    .filter p{
      margin:0.5rem 0 0 0;
      font-size: 0.8rem;
    }
   .tax-info{
    font-size: 0.8rem;
    display: none;
   }

.tax-toggle {
  border: 1px solid #454545;
  border-radius: 2rem;
  height:3rem;
  padding:  1rem;
  display: flex;
  align-items: center;
  margin : 0 0 0 auto;
  
 
}


.tax-toggle label {
  cursor: pointer;
}

.form-check-label{
  margin:0 0.5rem;
  height:auto;
}

.fa-solid{
  font-size: 1.25rem;
}



   </style>
     <div class="filters">
    <div class="filter">
        <i class="fa-solid fa-fire"></i>
        <p>Trending</p>
    </div>
    <div class="filter">
        <i class="fa-solid fa-umbrella-beach"></i>
        <p>Beach</p>
    </div>
    <div class="filter">
        <i class="fa-solid fa-mountain-sun"></i>
        <p>Hills</p>
    </div>
<div class="filter">
        <i class="fa-solid fa-water-ladder"></i>
        <p>Pools</p> 
        </div>
<div class="filter">
        <i class="fa-solid fa-city"></i>
        <p>Iconic Cities</p>
        </div>
<div class="filter">
        <i class="fa-solid fa-tree"></i>
        <p>Countryside</p>
          </div>
<div class="filter">
        <i class="fa-solid fa-snowflake"></i>
        <p>Arctic</p>
          </div>
<div class="filter">
       <i class="fa-solid fa-campground"></i>
        <p>Camping</p>
          </div>
<div class="filter">
     <i class="fa-solid fa-cow"></i>
        <p>Farms</p>
          </div>
          <div class="filter">
    <i class="fa-solid fa-bed"></i>
        <p>Rooms</p>
          </div>
          <div class="filter">
    <i class="fa-solid fa-sailboat"></i>
        <p>Houseboats</p>
          </div>
          <div class="filter">
    <i class="fa-solid fa-palette"></i>
        <p>Creative Spaces</p>
          </div>
   <div class="tax-toggle">
            <div class="form-check-reverse form-switch">
              <input class="form-check-input" 
              type="checkbox" 
              role="switch"
               id="switchCheckDefault">
               <label class="form-check-label" for="switchCheckDefault">
                total after taxes</label>
             </div>
          </div>
</div>

<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 row-cols-xs-1 mt-3 g-3">
<% for(let listing of alllistings){ %>
<a href=" /listings/<%=listing._id %>" class="listing-link">
<div class="card listing-card col">
  <img src="<%= listing.image.url %>" class="card-img-top" style="height:20rem">
   <div class="card-img-overlay">vegabond</div>
  <div class="card-body">
    <p class="card-text"><b><%= listing.title %></b><br>
   &#x20b9;<%= (typeof listing.price === "number"
    && !isNaN(listing.price) ? listing.price.toLocaleString("en-IN") : "N/A")
     %>/night
     <i class="tax-info">&nbsp;&nbsp;+18% GST</i>
     </p>
     
  </div>
</div>
    <% }%>
    </a>
</div>


<script>
let taxSwitch = document.getElementById("switchCheckDefault");

taxSwitch.addEventListener("click", () => {
  let taxInfo= document.getElementsByClassName("tax-info");
  for (info of taxInfo){
    if( info.style.display!= "inline"){
      info.style.display="inline";
    } else{
      info.style.display="none";
    }
  }
});

</script>    