<% layout("/layouts/boilerplate.ejs") %>
<div class="row mt-3">
    <div class="col-8 offset-2 mt-3">
    <h2> <%= listing.title %></h2>


    <div class="card listing-card col-6 offset-3" >
  <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="...">
  <div class="card-body">
    <p class="card-text">Owned by: <i><%= listing.owner ? listing.owner.username : "VegaBond host" %></i></p><br>
  
        
        <li>Description: <%= listing.description %></li><br>

        <li>Price:&#x20b9;<%= (typeof listing.price === "number" && !isNaN(listing.price) ? listing.price.toLocaleString("en-IN") : "N/A") %></li><br>
        <li>Location: <%= listing.location %></li><br>
        <li>country: <%=listing.country%></li><br>
  </div>
</div>


<% if(currUser && listing.owner && listing.owner._id.equals(currUser._id)){%> 

<div class="btns row">
    <div class="col-3 offset-2">
    <a href="/listings/<%=listing._id%>/edit" 
      class="btn btn-dark edit-btn  ">Edit </a>
</div><div class="col-4">
    <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE">
        <button  class="btn btn-dark del-btn ">Delete </button>
      </form>
      </div>
      </div>
   <% }%>
      
      <div class="col-8 offset-3 mb-3">
        <hr>
        <% if(currUser) {%>
        <h4>Leave a review</h4>
        <form method="POST" action="/listings/<%= listing.id %>/reviews">
         <div class="mb-3 mt-3">
          <label for="rating" class="form-label">Rating</label>
          <input type="range" min="1" max="5" id="rating" class="form-range" name="review[rating]">
         </div> 
         <div class="mb-3 mt-3">
           <label for="comment" class="form-label" class="form-control">Comments</label>
           <textarea name="review[comment]" id="comment" cols="20" rows="6" 
           class="form-control"
           required></textarea>
           <div class="invalid-feedback">add some reviews</div>
           </div>

           <button class="btn btn-outline-dark">Submit</button>
        </form>
        <%}%>
      

      <h6>All Reviews</h6>
      <div class="row">
         <% for(review of listing.reviews){%>
  <div class="card col-5 ms-3 mb-3 mb-sm-1">
    <div class="card-body">
        <h5 class="card-title">@<i><%= review.author ? review.author.username : "guest" %></i></h5>
        <p class="card-text"><%= review.comment %></p>
        <p class="card-text"><%= review.rating %>⭐</p>
<form class="mb-3"
method="POST"
action="/listings/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE">

<button class="btn btn-sm btn-dark">Delete</button>
</form>
         
      </div>
    </div>
  <%}%>
  </div>


</div>
</div>
</div>