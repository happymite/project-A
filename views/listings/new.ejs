<% layout("/layouts/boilerplate.ejs") %>
<section class="form-page">
  <p class="eyebrow">HOST WITH VEGABOND</p>
  <h1>Share your special place.</h1>
  <p class="intro">Tell us about your place — the details that make it worth staying at.</p>
  <form method="POST" action="/listings" enctype="multipart/form-data" class="listing-form">
    <div class="mb-3">
      <label class="form-label" for="title">Listing title</label>
      <input type="text" name="title" id="title" class="form-control" required>
    </div>
    <div class="mb-3">
      <label class="form-label" for="image">Cover image</label>
      <input type="file" class="form-control" name="image" id="image" accept="image/*" required>
    </div>
    <div class="mb-3">
      <label class="form-label" for="description">Description</label>
      <textarea class="form-control" rows="6" name="description" id="description" required></textarea>
    </div>
    <div class="row">
      <div class="mb-3 col-md-4">
        <label class="form-label" for="price">Nightly price (₹)</label>
        <input type="number" min="0" name="price" id="price" class="form-control" required>
      </div>
      <div class="mb-3 col-md-8">
        <label class="form-label" for="location">Location</label>
        <input type="text" name="location" id="location" class="form-control" required>
      </div>
    </div>
    <div class="mb-3">
      <label class="form-label" for="country">Country</label>
      <input type="text" name="country" class="form-control" id="country" required>
    </div>
    <div class="mb-4">
      <label class="form-label" for="category">Best fit</label>
      <select class="form-select" name="category" id="category" required>
        <option value="" disabled selected>Choose a category</option>
        <option value="beach">Beach</option>
        <option value="mountains">Mountains</option>
        <option value="city">City</option>
        <option value="countryside">Countryside</option>
        <option value="forest">Forest</option>
        <option value="island">Island</option>
        <option value="lake">Lake</option>
        <option value="desert">Desert</option>
        <option value="river">River</option>
        <option value="other">Other</option>
      </select>
    </div>
    <button type="submit" class="btn btn-dark">Publish listing <i class="fa-solid fa-arrow-right ms-1"></i></button>
  </form>
</section>